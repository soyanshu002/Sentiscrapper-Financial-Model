# Server Configuration
PORT=8000
HOST=127.0.0.1

# Reddit API Credentials (leaving blank triggers simulated fallback)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=SentiScrapper/1.0

# Financial Modeling Prep (FMP) API Credentials (leaving blank triggers simulated fallback)
FMP_API_KEY=your_fmp_api_key

# Telegram API Credentials (leaving blank triggers simulated fallback)
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash

# AlphaVantage API Credentials (leaving blank triggers simulated fallback)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key

# Twitter API Credentials (leaving blank triggers simulated fallback)
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# Gemini LLM API Credentials (optional, fallback to rule-based analysis if blank)
GEMINI_API_KEY=your_gemini_api_key
